        <content type="html">
            <![CDATA[
                    <p><img src="https://kunstmanu.ch/media/posts/86/IMG_9700.jpeg" class="type:primaryImage" alt="" /></p>
                <div class="gallery-wrapper"><div class="gallery"  data-is-empty="false" data-translation="Add images" data-columns="3">
<figure class="gallery__item"><a href="https://kunstmanu.ch/media/posts/86/gallery/IMG_9700-2.jpeg" data-size="4032x3024"><img loading="lazy" src="https://kunstmanu.ch/media/posts/86/gallery/IMG_9700-2-thumbnail.jpeg" alt="" width="720" height="540"></a></figure>
