            "date_published": "2026-01-01T21:08:25+01:00",
            "date_modified": "2026-01-19T07:02:16+01:00"
        },
        {
            "id": "https://kunstmanu.ch/eine-floete-und-eine-mittelmaessig-beeindruckte-sonne.html",
